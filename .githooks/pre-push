#!/usr/bin/env bash
# Formats the C++ sources before anything leaves the machine.
#
# If formatting changes something, the push is stopped. That is deliberate: the
# commits being pushed already exist, so reformatting now cannot alter them --
# letting the push through would send the unformatted code anyway and leave you
# with modified files afterwards. Stopping lets you commit the formatting first.
#
# Install with: scripts/install-hooks.sh
# Bypass once with: git push --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

if ! command -v "${CLANG_FORMAT:-clang-format}" >/dev/null 2>&1; then
  echo "pre-push: clang-format not found, skipping the format check." >&2
  echo "          Install it, or push with --no-verify to silence this." >&2
  exit 0
fi

# Only consider files that are actually committed, so untracked scratch files
# in src/ never block a push.
mapfile -t TRACKED < <(git -C "${ROOT}" ls-files 'src/*.cpp' 'src/*.hpp' 'tests/*.cpp' 'tests/*.hpp')
[[ "${#TRACKED[@]}" -eq 0 ]] && exit 0

"${CLANG_FORMAT:-clang-format}" --style=file -i "${TRACKED[@]}"

if ! git -C "${ROOT}" diff --quiet -- "${TRACKED[@]}"; then
  echo >&2
  echo "pre-push: these files were not formatted and have now been reformatted:" >&2
  git -C "${ROOT}" diff --name-only -- "${TRACKED[@]}" | sed 's/^/  /' >&2
  echo >&2
  echo "The push was stopped -- your commits still contain the unformatted code." >&2
  echo "Review the changes, then commit and push again:" >&2
  echo >&2
  echo "  git add -u && git commit -m 'Apply clang-format' && git push" >&2
  echo >&2
  exit 1
fi

exit 0
